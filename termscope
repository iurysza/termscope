class ClipboardError(Exception):
    """No clipboard tool accepted the text."""


def _clipboard_commands() -> list[list[str]]:
    commands: list[list[str]] = []
    if sys.platform == "darwin":
        commands.append(["pbcopy"])
    if os.environ.get("WAYLAND_DISPLAY"):
        commands.append(["wl-copy"])
    if os.environ.get("DISPLAY"):
        commands.append(["xclip", "-selection", "clipboard"])
        commands.append(["xsel", "--clipboard", "--input"])
    return commands


# OSC 52 cannot confirm the terminal stored the text. Callers use "sent"
# for that write and "copied" when a native tool exits 0.
_TTY_PATH = "/dev/tty"
_OSC52_MAX_BASE64 = 100 * 1024


def _osc52_sequence(text: str) -> bytes | None:
    """Return an OSC 52 write, or None when the base64 payload is over the cap."""
    encoded = base64.b64encode(text.encode("utf-8"))
    if len(encoded) > _OSC52_MAX_BASE64:
        return None
    sequence = b"\033]52;c;" + encoded + b"\a"
    if os.environ.get("TMUX"):
        sequence = b"\033Ptmux;" + sequence.replace(b"\033", b"\033\033") + b"\033\\"
    return sequence


def _write_tty(data: bytes) -> None:
    with open(_TTY_PATH, "wb", buffering=0) as tty:
        written = tty.write(data)
    if written != len(data):
        raise OSError("short write to controlling terminal")


def copy_to_clipboard(text: str) -> str:
    """Copy text. Return "copied" or "sent", or raise ClipboardError."""
    for command in _clipboard_commands():
        try:
            # xclip's forked clipboard server inherits stdout. A pipe with no
            # reader keeps this call waiting, so discard stdio.
            result = subprocess.run(
                command,
                input=text,
                text=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except OSError:
            continue
        if result.returncode == 0:
            return "copied"
    sequence = _osc52_sequence(text)
    if sequence is None:
        raise ClipboardError("Could not copy to clipboard")
    try:
        _write_tty(sequence)
    except OSError as exc:
        raise ClipboardError("Could not copy to clipboard") from exc
    return "sent"


def clipboard_message(status: str | None) -> str:
    if status == "sent":
        return "Link sent to terminal clipboard"
    if status == "copied":
        return "Link copied to clipboard"
    return "Could not copy link to clipboard"


