class MultiplexerBackend(ABC):
    """Abstracts tmux- and herdr-specific control commands."""

    @property
    @abstractmethod
    def name(self) -> str:
        ...

    @abstractmethod
    def resolve_source_pane_path(self, pane_path: Path, pane_id: str) -> Path:
        """Return the best cwd for the source pane."""
        ...

    @abstractmethod
    def capture_pane_text(self, pane_id: str) -> str:
        """Return the currently visible text from the source pane."""
        ...

    @abstractmethod
    def open_in_nvim_split(
        self, path: Path, line: str, pane_path: Path, pane_id: str
    ) -> NoReturn:
        """Open path in a new nvim split next to the source pane, then exit."""
        ...

    @abstractmethod
    def send_annotate_command(self, pane_id: str, file_path: str) -> None:
        """Request Plannotator through the source pane's active interface."""
        ...

    @abstractmethod
    def show_message(self, message: str) -> None:
        """Show a short, non-blocking message to the user."""
        ...


class TmuxBackend(MultiplexerBackend):
    @property
    def name(self) -> str:
        return "tmux"

    def resolve_source_pane_path(self, pane_path: Path, pane_id: str) -> Path:
        if pane_id:
            try:
                result = subprocess.run(
                    ["tmux", "display-message", "-p", "-t", pane_id, "#{pane_current_path}"],
                    text=True,
                    capture_output=True,
                    check=False,
                )
                p = result.stdout.strip()
                if p and Path(p).is_dir():
                    return Path(p)
            except FileNotFoundError:
                pass
        return pane_path

    def capture_pane_text(self, pane_id: str) -> str:
        text = self._capture_single(pane_id)
        if not pane_id:
            return text
        try:
            listing = subprocess.run(
                ["tmux", "list-panes", "-t", pane_id, "-F", "#{pane_id}"],
                text=True,
                capture_output=True,
                check=False,
            )
            canon = subprocess.run(
                ["tmux", "display-message", "-p", "-t", pane_id, "#{pane_id}"],
                text=True,
                capture_output=True,
                check=False,
            ).stdout.strip()
        except FileNotFoundError:
            return text
        if listing.returncode != 0:
            log_event("capture_window_fallback", pane_id=pane_id, reason=listing.stderr.strip())
            return text
        texts = [text]
        for pid in listing.stdout.split():
            if pid and pid not in (canon, pane_id):
                texts.append(self._capture_single(pid))
        return "\n".join(texts)

    def _capture_single(self, pane_id: str) -> str:
        cmd = ["tmux", "capture-pane", "-pJ"]

        # If the source pane is in copy mode, capture the scrolled viewport
        # instead of the live bottom content. This only works if the binding does
        # not cancel copy mode before launching this script.
        if pane_id:
            mode_result = subprocess.run(
                ["tmux", "display-message", "-p", "-t", pane_id, "#{pane_in_mode}"],
                text=True,
                capture_output=True,
                check=False,
            )
            if mode_result.stdout.strip() == "1":
                scroll_result = subprocess.run(
                    ["tmux", "display-message", "-p", "-t", pane_id, "#{scroll_position}"],
                    text=True,
                    capture_output=True,
                    check=False,
                )
                height_result = subprocess.run(
                    ["tmux", "display-message", "-p", "-t", pane_id, "#{pane_height}"],
                    text=True,
                    capture_output=True,
                    check=False,
                )
                scroll_str = scroll_result.stdout.strip()
                height_str = height_result.stdout.strip()
                if scroll_str.isdigit() and height_str.isdigit():
                    scroll = int(scroll_str)
                    height = int(height_str)
                    if scroll > 0 and height > 0:
                        if scroll < height:
                            end = str(height - scroll - 1)
                        else:
                            end = f"-{scroll - height + 1}"
                        cmd.extend(["-S", f"-{scroll}", "-E", end])
                        log_event(
                            "capture_scrollback_viewport",
                            pane_id=pane_id,
                            scroll_position=scroll,
                            pane_height=height,
                            start=f"-{scroll}",
                            end=end,
                        )

            cmd.extend(["-t", pane_id])

        result = subprocess.run(cmd, text=True, capture_output=True, check=False)
        return result.stdout

    def open_in_nvim_split(
        self, path: Path, line: str, pane_path: Path, pane_id: str
    ) -> NoReturn:
        cmd = ["nvim", f"+{line}", str(path)] if line else ["nvim", str(path)]
        inner = shlex.join(cmd)

        tmux_cmd = ["tmux", "split-window"]
        if pane_id:
            tmux_cmd += ["-t", pane_id]
        tmux_cmd += ["-h", "-c", str(pane_path), inner]

        os.execvp(tmux_cmd[0], tmux_cmd)

    def send_annotate_command(self, pane_id: str, file_path: str) -> None:
        # Cancel copy mode so the command reaches the source application.
        pane_result = subprocess.run(
            [
                "tmux",
                "display-message",
                "-p",
                "-t",
                pane_id,
                "#{pane_in_mode}\t#{pane_current_command}",
            ],
            text=True,
            capture_output=True,
            check=False,
        )
        fields = pane_result.stdout.rstrip("\n").split("\t", 1)
        in_copy_mode = fields[0] == "1"
        current_command = fields[1].lower() if len(fields) == 2 else ""
        if in_copy_mode:
            subprocess.run(
                ["tmux", "send-keys", "-t", pane_id, "-X", "cancel"],
                check=False,
            )

        quoted_path = shlex.quote(file_path)
        agent_commands = {"pi", "opencode", "claude", "codex"}
        if not current_command or current_command in agent_commands:
            cmd_text = f"/plannotator-annotate {quoted_path}"
        else:
            cmd_text = f"plannotator annotate {quoted_path}"
        subprocess.run(
            ["tmux", "send-keys", "-t", pane_id, "-l", cmd_text],
            check=False,
        )
        subprocess.run(
            ["tmux", "send-keys", "-t", pane_id, "Enter"],
            check=False,
        )
        self.show_message("Plannotator annotation requested")

    def show_message(self, message: str) -> None:
        subprocess.run(
            ["tmux", "display-message", message],
            check=False,
        )


def _has_terminal() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def _app_config_path() -> Path:
    """Settings file for Herdr.app: explicit env, plugin dir, else the legacy Herdr one."""
    explicit = os.environ.get("TERMSCOPE_CONFIG", "").strip()
    if explicit:
        return Path(explicit)
    config_dir = os.environ.get("HERDR_PLUGIN_CONFIG_DIR", "")
    if config_dir:
        return Path(config_dir) / "config.toml"
    return Path.home() / ".config" / "herdr" / "plugins" / "config" / "termscope" / "config.toml"


def open_settings(app: bool = False) -> dict:
    """Open-behavior settings from the Herdr plugin config directory.

    With app=True the file comes from `_app_config_path`. Herdr.app and Rex
    both pass app=True, so `TERMSCOPE_CONFIG` overrides the plugin file.
    """
    settings: dict = {"open_target": "split", "close_on_exit": False}

    if app:
        config_path: Path | None = _app_config_path()
    else:
        config_dir = os.environ.get("HERDR_PLUGIN_CONFIG_DIR", "")
        config_path = Path(config_dir) / "config.toml" if config_dir else None
    if config_path and config_path.is_file():
        try:
            import tomllib

            with config_path.open("rb") as fh:
                data = tomllib.load(fh)
            if data.get("open_target") in ("split", "tab", "popup"):
                settings["open_target"] = data["open_target"]
            if isinstance(data.get("close_on_exit"), bool):
                settings["close_on_exit"] = data["close_on_exit"]
        except (ModuleNotFoundError, OSError, ValueError):
            pass

    log_event("open_settings", **settings)
    return settings


class HerdrBackend(MultiplexerBackend):
    @property
    def name(self) -> str:
        return "herdr"

    def _herdr_bin(self) -> str:
        return os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr") or "herdr"

    def resolve_source_pane_path(self, pane_path: Path, pane_id: str) -> Path:
        if not pane_id:
            return pane_path
        try:
            result = subprocess.run(
                [self._herdr_bin(), "pane", "get", pane_id],
                text=True,
                capture_output=True,
                check=False,
            )
            if result.returncode != 0:
                return pane_path
            data = json.loads(result.stdout)
            p = data.get("result", {}).get("pane", {}).get("cwd", "")
            if p and Path(p).is_dir():
                return Path(p)
        except (FileNotFoundError, json.JSONDecodeError):
            pass
        return pane_path

    def capture_pane_text(self, pane_id: str) -> str:
        return "\n".join(self._read_visible(pane) for pane in self._tab_panes(pane_id))

    def _read_visible(self, pane: dict) -> str:
        """The pane's visible rows, with soft-wrapped lines joined back together.

        `--source visible` returns raw screen rows, so a path the terminal wrapped
        arrives in two halves and matches nothing (tmux gets the same fix from
        `capture-pane -J`). `recent-unwrapped` over the viewport's row count is the
        same screen with wraps joined. It reads from the bottom, so a pane scrolled
        back into history, or a Herdr without the source, falls back to `visible`.
        """
        pid = pane["pane_id"]
        scroll = pane.get("scroll") or {}
        rows = scroll.get("viewport_rows")
        if isinstance(rows, int) and rows > 0 and not scroll.get("offset_from_bottom"):
            result = subprocess.run(
                [self._herdr_bin(), "pane", "read", pid,
                 "--source", "recent-unwrapped", "--lines", str(rows)],
                text=True,
                capture_output=True,
                check=False,
            )
            if result.returncode == 0:
                return result.stdout
            log_event(
                "capture_unwrapped_fallback",
                pane_id=pid,
                reason=(getattr(result, "stderr", "") or "").strip(),
            )
        result = subprocess.run(
            [self._herdr_bin(), "pane", "read", pid, "--source", "visible"],
            text=True,
            capture_output=True,
            check=False,
        )
        return result.stdout

    def _tab_pane_ids(self, pane_id: str) -> list[str]:
        return [pane["pane_id"] for pane in self._tab_panes(pane_id)]

    def _tab_panes(self, pane_id: str) -> list[dict]:
        """All panes in pane_id's tab — source pane first, skipping our own popup."""
        # Sibling panes' relative paths resolve against the source pane's root.
        try:
            result = subprocess.run(
                [self._herdr_bin(), "pane", "list"],
                text=True,
                capture_output=True,
                check=False,
            )
            panes = json.loads(result.stdout)["result"]["panes"]
        except (FileNotFoundError, json.JSONDecodeError, KeyError, TypeError):
            log_event("capture_tab_fallback", pane_id=pane_id, reason="pane list unreadable")
            return [{"pane_id": pane_id}]
        source = next((p for p in panes if p.get("pane_id") == pane_id), None)
        tab_id = source.get("tab_id") if source else None
        if tab_id is None:
            log_event("capture_tab_fallback", pane_id=pane_id, reason="source pane not listed")
            return [{"pane_id": pane_id}]
        own_id = os.environ.get("HERDR_PANE_ID")
        popup_id = own_id if own_id != pane_id else None
        tab_panes = [
            p
            for p in panes
            if p.get("tab_id") == tab_id and p.get("pane_id") not in (None, popup_id)
        ]
        tab_panes.sort(key=lambda p: p["pane_id"] != pane_id)
        return tab_panes

    def open_in_nvim_split(
        self, path: Path, line: str, pane_path: Path, pane_id: str
    ) -> NoReturn:
        settings = open_settings()
        herdr = self._herdr_bin()

        if settings["open_target"] == "popup" and _has_terminal():
            # The picker already runs in a Herdr popup: replace it with nvim, so
            # the file opens in that popup and the popup closes when nvim exits.
            # Without a terminal (CLI use), fall through to a split.
            # Herdr's popup PATH often omits Homebrew. Resolve nvim the same way
            # as Television, then exec that absolute path. Split and tab still
            # pass a bare `nvim` command to `herdr pane run`: that starts the
            # pane shell, which already has Homebrew on PATH.
            nvim = _nvim_path()
            if not nvim:
                sys.exit("termscope: nvim not found")
            os.chdir(pane_path)
            argv = [nvim, f"+{line}", str(path)] if line else [nvim, str(path)]
            os.execvp(argv[0], argv)

        if settings["open_target"] == "tab":
            subcommand = ["tab", "create", "--cwd", str(pane_path), "--focus"]
            pane_key = "root_pane"
        else:
            subcommand = ["pane", "split", pane_id, "--direction", "right", "--cwd", str(pane_path)]
            pane_key = "pane"

        label = f"herdr {' '.join(subcommand[:2])}"
        result = subprocess.run(
            [herdr, *subcommand],
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode != 0:
            print(f"termscope: {label} failed: {result.stderr}", file=sys.stderr)
            sys.exit(1)

        try:
            data = json.loads(result.stdout)
            new_pane_id = data["result"][pane_key]["pane_id"]
        except (json.JSONDecodeError, KeyError) as exc:
            print(f"termscope: could not parse {label} response: {exc}", file=sys.stderr)
            sys.exit(1)

        nvim_cmd = f"nvim +{line} {shlex.quote(str(path))}" if line else f"nvim {shlex.quote(str(path))}"
        if settings["close_on_exit"]:
            # exec replaces the pane shell so the pane closes when nvim exits
            nvim_cmd = f"exec {nvim_cmd}"
        subprocess.run(
            [herdr, "pane", "run", new_pane_id, nvim_cmd],
            check=False,
        )
        sys.exit(0)

    def send_annotate_command(self, pane_id: str, file_path: str) -> None:
        herdr = self._herdr_bin()
        quoted_path = shlex.quote(file_path)
        source_agent = os.environ.get("SOURCE_PANE_AGENT")
        if source_agent is None or source_agent:
            command = f"/plannotator-annotate {quoted_path}"
        else:
            command = f"plannotator annotate {quoted_path}"
        subprocess.run(
            [herdr, "pane", "run", pane_id, command],
            check=False,
        )
        self.show_message("Plannotator annotation requested")

    def show_message(self, message: str) -> None:
        subprocess.run(
            [self._herdr_bin(), "notification", "show", message],
            check=False,
        )

_AGENT_APPS_SHELL = ("", "shell", "zsh", "bash", "fish", "sh")


def _tool_bin(env_name: str, which_name: str) -> str:
    """Resolve an auxiliary CLI: env override, PATH, ~/.local/bin, bare name."""
    configured = os.environ.get(env_name, "").strip()
    if configured:
        return configured
    found = shutil.which(which_name)
    if found:
        return found
    local = Path.home() / ".local" / "bin" / which_name
    if _is_executable(str(local)):
        return str(local)
    return which_name


class AppBackend(MultiplexerBackend):
    """Herdr.app: `hc` for terminals, `herdr-app` for panes and tabs.

    The "pane id" passed around is the source *terminal* id (`t14x`).
    """

    @property
    def name(self) -> str:
        return "app"

    def _hc(self) -> str:
        return _tool_bin("HC_BIN_PATH", "hc")

    def _herdr_app(self) -> str:
        return _tool_bin("HERDR_APP_BIN_PATH", "herdr-app")

    def _hc_get(self, terminal: str) -> dict:
        try:
            result = subprocess.run(
                [self._hc(), "get", terminal],
                text=True, capture_output=True, check=False,
            )
            if result.returncode != 0:
                return {}
            data = json.loads(result.stdout)
            return data if isinstance(data, dict) else {}
        except (OSError, json.JSONDecodeError):
            return {}

    def resolve_source_pane_path(self, pane_path: Path, pane_id: str) -> Path:
        if not pane_id:
            return pane_path
        data = self._hc_get(pane_id)
        foreground = data.get("foreground")
        candidates = [
            foreground.get("cwd") if isinstance(foreground, dict) else None,
            data.get("cwd"),
        ]
        for candidate in candidates:
            if isinstance(candidate, str) and candidate and Path(candidate).is_dir():
                return Path(candidate)
        return pane_path

    def capture_pane_text(self, pane_id: str) -> str:
        # `hc read --lines 0` is the visible screen. Soft-wrapped rows are not
        # joined by hc (screen mode), so a wrapped path may arrive in two halves.
        try:
            result = subprocess.run(
                [self._hc(), "read", pane_id, "--json", "--lines", "0"],
                text=True, capture_output=True, check=False,
            )
            if result.returncode != 0:
                log_event("app_capture_failed", pane_id=pane_id, stderr=result.stderr.strip())
                return ""
            data = json.loads(result.stdout)
            text = data.get("text", "")
            return text if isinstance(text, str) else ""
        except (OSError, json.JSONDecodeError):
            return ""

    def _find_pane(self, terminal: str) -> tuple[str | None, str | None]:
        """(pane id, space id) of a terminal from `herdr-app ls`."""
        try:
            result = subprocess.run(
                [self._herdr_app(), "ls"],
                text=True, capture_output=True, check=False,
            )
            data = json.loads(result.stdout)
            for space in data.get("spaces", []):
                for tab in space.get("tabs", []):
                    for term in tab.get("terminals", []):
                        if term.get("terminal") == terminal:
                            return term.get("pane"), space.get("id")
        except (OSError, json.JSONDecodeError, AttributeError):
            pass
        return None, None

    def _do(self, command: str, **kwargs: str) -> subprocess.CompletedProcess:
        argv = [self._herdr_app(), "do", command]
        for key, value in kwargs.items():
            argv.extend([f"--{key}", value])
        return subprocess.run(argv, text=True, capture_output=True, check=False)

    def open_in_nvim_split(
        self, path: Path, line: str, pane_path: Path, pane_id: str
    ) -> NoReturn:
        settings = open_settings(app=True)
        nvim = _nvim_path() or "nvim"
        nvim_argv = [nvim, f"+{line}", str(path)] if line else [nvim, str(path)]

        if settings["open_target"] == "popup" and _has_terminal():
            # The picker runs in a float with a TTY: become nvim there.
            if not _nvim_path():
                sys.exit("termscope: nvim not found")
            os.chdir(pane_path)
            os.execvp(nvim_argv[0], nvim_argv)

        argv_json = json.dumps(nvim_argv)
        if settings["open_target"] == "tab":
            _pane, space = self._find_pane(pane_id)
            if not space:
                # tab.new needs the source space. The selected space can be a
                # different one while the picker float is showing.
                print(f"termscope: could not find the space of {pane_id}", file=sys.stderr)
                sys.exit(1)
            kwargs = {"folder": str(pane_path), "name": "nvim", "argv": argv_json, "space": space}
            label = "tab.new"
            result = self._do("tab.new", **kwargs)
        else:
            pane, _space = self._find_pane(pane_id)
            if not pane:
                print(f"termscope: could not find the pane of {pane_id}", file=sys.stderr)
                sys.exit(1)
            label = "pane.split"
            result = self._do("pane.split", pane=pane, direction="right", argv=argv_json)

        if result.returncode != 0:
            print(f"termscope: herdr-app {label} failed: {result.stderr.strip()}", file=sys.stderr)
            sys.exit(1)
        sys.exit(0)

    def send_annotate_command(self, pane_id: str, file_path: str) -> None:
        quoted_path = shlex.quote(file_path)
        app = ((self._hc_get(pane_id).get("status") or {}).get("app") or "").strip()
        if app and app not in _AGENT_APPS_SHELL:
            command = f"/plannotator-annotate {quoted_path}"
        else:
            command = f"plannotator annotate {quoted_path}"
        subprocess.run([self._hc(), "send", pane_id, command], check=False)
        self.show_message("Plannotator annotation requested")

    def show_message(self, message: str) -> None:
        # Herdr.app has no CLI toast; stderr is non-blocking.
        print(f"termscope: {message}", file=sys.stderr)


_REX_BLOCK_RE = re.compile(r"^block:[0-9A-Fa-f-]+$")
_REX_BUNDLE = (
    "Library/Application Support/com.superlogical.rex/RexServer/"
    "Versions/Current/Rex Server.app/Contents/MacOS/rex"
)
# Same set tmux uses for pane_current_command. Rex reports a process name.
_REX_AGENTS = {"pi", "opencode", "claude", "codex"}


def rex_file_url_path(value: object) -> str | None:
    """Path from Rex `pwd`.

    After OSC 7 the value is a file:// URL. Some shells report a plain absolute
    path instead.
    """
    if not isinstance(value, str) or not value:
        return None
    if value.startswith("file://"):
        rest = value[len("file://"):]
        slash = rest.find("/")
        if slash < 0:
            return None
        path = unquote(rest[slash:])
        return path or None
    if value.startswith("/"):
        return value
    return None


def rex_binary() -> str | None:
    """Resolve the Rex CLI the way `herdr-ui` does.

    `REX_BIN`, otherwise `rex` on `PATH`, otherwise the Rex Server app bundle.
    """
    configured = os.environ.get("REX_BIN", "").strip()
    if configured:
        return configured
    found = shutil.which("rex")
    if found:
        return found
    bundled = Path.home() / _REX_BUNDLE
    if os.path.isfile(bundled) and os.access(bundled, os.X_OK):
        return str(bundled)
    return None


def window_id_from_view(view: object, block_id: str) -> str | None:
    """Window that contains block_id in a `session.view` snapshot.

    Matches the walk in herdr-ui: windows, then layers, then blocks.
    """
    if not isinstance(view, dict):
        return None
    windows = view.get("windows")
    if not isinstance(windows, list):
        return None
    for window in windows:
        if not isinstance(window, dict):
            continue
        layers = window.get("layers")
        if not isinstance(layers, list):
            continue
        for layer in layers:
            if not isinstance(layer, dict):
                continue
            blocks = layer.get("blocks")
            if not isinstance(blocks, list):
                continue
            for block in blocks:
                if isinstance(block, dict) and block.get("block_id") == block_id:
                    window_id = window.get("window_id")
                    if isinstance(window_id, str) and window_id:
                        return window_id
    return None


class RexBackend(MultiplexerBackend):
    """Rex block: `rex capture` for text, `rex split` or `rex run` to open nvim.

    The pane id is the source block id. `rex capture` prints the screen and the
    scrollback (`--trim` drops trailing blank lines, `--unwrap` joins soft
    wraps). The public CLI has no viewport-only flag, so the text is returned
    as Rex printed it.
    """

    @property
    def name(self) -> str:
        return "rex"

    def _block(self, pane_id: str) -> str:
        return pane_id or os.environ.get("REX_BLOCK", "").strip()

    def _session(self) -> str:
        return os.environ.get("REX_SESSION", "").strip()

    def _command(self, args: list[str]) -> list[str] | None:
        binary = rex_binary()
        if not binary or not args:
            return None
        session = self._session()
        if session and args[:2] == ["api", "call"]:
            return [binary, "api", "call", "-s", session, *args[2:]]
        if session:
            return [binary, args[0], "-s", session, *args[1:]]
        return [binary, *args]

    def _api(self, method: str, payload: dict) -> dict:
        cmd = self._command(["api", "call", method, "-"])
        if not cmd:
            return {}
        try:
            result = subprocess.run(
                cmd,
                input=json.dumps(payload),
                text=True,
                capture_output=True,
                check=False,
                timeout=15,
            )
        except (OSError, subprocess.TimeoutExpired):
            return {}
        if result.returncode != 0 or not result.stdout.strip():
            return {}
        try:
            data = json.loads(result.stdout)
        except json.JSONDecodeError:
            return {}
        return data if isinstance(data, dict) else {}

    def window_id(self, pane_id: str) -> str | None:
        """Window that holds the source block, so a float stays on its tab."""
        block = self._block(pane_id)
        if not block:
            return None
        described = self._api("session.describe_block", {"block_id": block})
        info = described.get("block")
        if isinstance(info, dict):
            window_id = info.get("window_id")
            if isinstance(window_id, str) and window_id:
                return window_id
        return window_id_from_view(self._api("session.view", {}), block)

    def resolve_source_pane_path(self, pane_path: Path, pane_id: str) -> Path:
        block = self._block(pane_id)
        if not block:
            return pane_path
        reported = self._api(
            "com.superlogical.terminal.pwd", {"block_id": block, "args": {}},
        )
        path = rex_file_url_path(reported.get("pwd"))
        if path and Path(path).is_dir():
            return Path(path)
        process = self._api(
            "com.superlogical.terminal.process", {"block_id": block, "args": {}},
        )
        foreground = process.get("foreground")
        cwd = foreground.get("cwd") if isinstance(foreground, dict) else None
        if isinstance(cwd, str) and cwd and Path(cwd).is_dir():
            return Path(cwd)
        return pane_path

    def capture_pane_text(self, pane_id: str) -> str:
        block = self._block(pane_id)
        cmd = self._command(["capture", "-b", block, "--trim", "--unwrap"]) if block else None
        if not cmd:
            return ""
        try:
            result = subprocess.run(
                cmd, text=True, capture_output=True, check=False, timeout=15,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            log_event("rex_capture_failed", pane_id=block, error=type(exc).__name__)
            return ""
        if result.returncode != 0:
            log_event(
                "rex_capture_failed",
                pane_id=block,
                stderr=(result.stderr or "").strip()[:500],
            )
            return ""
        return self._visible_rows(block, result.stdout)

    def _visible_rows(self, block: str, text: str) -> str:
        """Keep the last `rows` lines: capture adds scrollback, the block shows `rows`."""
        size = self._api("block.method", {"block_id": block, "method": "size"})
        rows = size.get("rows")
        if not isinstance(rows, int) or rows <= 0:
            return text
        lines = text.splitlines()
        if len(lines) <= rows:
            return text
        return "\n".join(lines[-rows:]) + "\n"

    def _nvim_argv(self, path: Path, line: str) -> list[str]:
        nvim = _nvim_path() or "nvim"
        return [nvim, f"+{line}", str(path)] if line else [nvim, str(path)]

    def open_in_nvim_split(
        self, path: Path, line: str, pane_path: Path, pane_id: str
    ) -> NoReturn:
        settings = open_settings(app=True)
        block = self._block(pane_id)

        if settings["open_target"] == "popup" and _has_terminal():
            if not _nvim_path():
                sys.exit("termscope: nvim not found")
            argv = self._nvim_argv(path, line)
            os.chdir(pane_path)
            os.execvp(argv[0], argv)

        if not block:
            print("termscope: no Rex block to open beside", file=sys.stderr)
            sys.exit(1)

        if settings["open_target"] == "tab":
            label = "run"
            args = ["run", "-c", str(pane_path), "--label", "nvim"]
        else:
            label = "split"
            args = [
                "split", "-b", block, "--split=right", "-c", str(pane_path), "--label", "nvim",
            ]
        # Default Rex closes the block when its command exits. --keep-open
        # leaves it, matching close_on_exit = false.
        if not settings["close_on_exit"]:
            args.append("--keep-open")
        cmd = self._command(args)
        if not cmd:
            print("termscope: rex not found (set REX_BIN or install the Rex CLI)", file=sys.stderr)
            sys.exit(1)
        cmd.extend(["--", *self._nvim_argv(path, line)])
        try:
            result = subprocess.run(cmd, text=True, capture_output=True, check=False, timeout=15)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"termscope: rex {label} failed: {exc}", file=sys.stderr)
            sys.exit(1)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout or "").strip()
            print(f"termscope: rex {label} failed: {detail}", file=sys.stderr)
            sys.exit(1)
        sys.exit(0)

    def send_annotate_command(self, pane_id: str, file_path: str) -> None:
        block = self._block(pane_id)
        quoted = shlex.quote(file_path)
        name = ""
        if block:
            process = self._api(
                "com.superlogical.terminal.process", {"block_id": block, "args": {}},
            )
            foreground = process.get("foreground")
            if isinstance(foreground, dict):
                name = str(foreground.get("name") or "").strip().lower()
        if not name or name in _REX_AGENTS:
            command = f"/plannotator-annotate {quoted}"
        else:
            command = f"plannotator annotate {quoted}"
        if block:
            send = self._command(["send", "-b", block, command])
            key = self._command(["send-key", "-b", block, "enter"])
            if send:
                subprocess.run(send, check=False)
            if key:
                subprocess.run(key, check=False)
        self.show_message("Plannotator annotation requested")

    def show_message(self, message: str) -> None:
        # Rex has no termscope toast on the CLI. stderr stays in the picker layer.
        print(f"termscope: {message}", file=sys.stderr)


def _rex_autodetect(pane_id: str) -> bool:
    """True when the pane id is a Rex block, or the Rex env names this pane."""
    if pane_id and _REX_BLOCK_RE.match(pane_id):
        return True
    session = os.environ.get("REX_SESSION", "").strip()
    block = os.environ.get("REX_BLOCK", "").strip()
    if not session or not block:
        return False
    return not pane_id or pane_id == block


def detect_backend(pane_id: str) -> MultiplexerBackend:
    """Pick a backend from the pane id shape, then from the Rex environment."""
    if pane_id and re.match(r"^(?:w[0-9A-Za-z]+:p[0-9A-Za-z]+|\d+-\d+)$", pane_id):
        return HerdrBackend()
    if pane_id and re.match(r"^t[0-9a-z]+$", pane_id):
        return AppBackend()
    if _rex_autodetect(pane_id):
        return RexBackend()
    return TmuxBackend()


def choose_backend(multiplexer: str, pane_id: str) -> MultiplexerBackend:
    if multiplexer == "tmux":
        return TmuxBackend()
    if multiplexer == "herdr":
        return HerdrBackend()
    if multiplexer == "app":
        return AppBackend()
    if multiplexer == "rex":
        return RexBackend()
    return detect_backend(pane_id)


