# File indexing
# --------------------------------------------------------------------------- #

def list_repo_files(search_root: Path) -> list[str]:
    # Skip home directory — too large to index.
    home = Path.home()
    try:
        search_root.resolve().relative_to(home.resolve())
        if search_root.resolve() == home.resolve():
            return []
    except ValueError:
        pass  # Not under home, ok to scan

    try:
        result = subprocess.run(
            [
                "fd",
                "--type",
                "f",
                "--type",
                "d",
                "--hidden",
                "--follow",
                "--exclude",
                ".git",
                ".",
            ],
            cwd=search_root,
            text=True,
            capture_output=True,
            timeout=5,  # Don't hang on huge directories
            check=False,
        )
    except FileNotFoundError:
        return []
    except subprocess.TimeoutExpired:
        return []
    if result.returncode != 0:
        return []
    lines = [ln.rstrip("\n") for ln in result.stdout.splitlines() if ln.rstrip("\n")]
    # Bound scan cost and picker startup time on very large repositories.
    return lines[:5000]


# --------------------------------------------------------------------------- #
# Candidate extraction
# --------------------------------------------------------------------------- #

# Characters that end a path-like token on screen. Paths with these in their
# names can still match when a whole line or a quoted span is the path.
TOKEN_RE = re.compile(r"[^\s`'\"<>|()\[\]{},;=]+")
QUOTED_RE = re.compile(r"[`'\"]([^`'\"]+)[`'\"]")
LINE_SUFFIX_RE = re.compile(r"^(.+?):(\d+)(?::\d+)?:?$")
# Tokens that are only home/root/dot markers, e.g. "~/..." after trimming dots.
BARE_MARKERS = {"~", "~/", "/", ".", "./", "..", "../"}


def _split_line_suffix(token: str) -> tuple[str, str]:
    token = token.rstrip(".,;!?")
    m = LINE_SUFFIX_RE.match(token)
    if m:
        return m.group(1), m.group(2)
    return token.rstrip(":."), ""


def extract_visible_candidates(
    screen_text: str,
    repo_paths: list[str],
    search_root: Path,
    pane_path: Path,
    sort: str = "appearance",
) -> list[str]:
    """Visible text that names an existing file or folder.

    The screen drives the search: each path-like token is checked on disk.
    Tokens with a "/" resolve against the pane, the repo root, or home.
    A bare name must exist at the pane or repo root. It can also match a
    unique repo basename when it carries a line number or stands alone,
    alone meaning a whole line or a quoted span. A bare name without an
    extension, like "README", only counts when it stands alone.
    """
    home = Path.home()
    root_str = str(search_root)

    indexed = {os.path.join(root_str, p.rstrip("/")) for p in repo_paths}
    by_basename: dict[str, list[str]] = {}
    for path in repo_paths:
        clean = path.rstrip("/")
        by_basename.setdefault(os.path.basename(clean), []).append(clean)

    matches: dict[str, int] = {}

    def display_for(abs_path: str) -> str:
        if abs_path.startswith(root_str + os.sep):
            return os.path.relpath(abs_path, root_str)
        try:
            rel = Path(abs_path).relative_to(home)
        except ValueError:
            return abs_path
        return "~" if str(rel) == "." else f"~/{rel}"

    def resolve(base: str, standalone: bool, has_line: bool) -> str | None:
        if base in BARE_MARKERS or "://" in base:
            return None
        if base.startswith(("~", "/")):
            bases = [os.path.expanduser(base)]
        elif base.startswith(("./", "../")):
            bases = [os.path.join(pane_path, base)]
        elif "/" in base:
            bases = [os.path.join(pane_path, base), os.path.join(search_root, base)]
        else:
            has_ext = "." in base.strip(".")
            if not (has_ext or standalone):
                return None
            names = [base] if has_ext else [base, base + ".md"]
            bases = [os.path.join(d, n) for d in (pane_path, search_root) for n in names]
            if has_line or standalone:
                for name in names:
                    hits = by_basename.get(name, [])
                    if len(hits) == 1:
                        bases.append(os.path.join(search_root, hits[0]))
        for candidate in bases:
            candidate = os.path.abspath(candidate)
            if candidate in indexed or os.path.exists(candidate):
                return display_for(candidate)
        return None

    def consider(token: str, pos: int, standalone: bool) -> None:
        base, line_num = _split_line_suffix(token.strip())
        if not base:
            return
        display = resolve(base, standalone, bool(line_num))
        if display is None:
            return
        if line_num:
            display = f"{display}:{line_num}"
        if display not in matches or pos < matches[display]:
            matches[display] = pos

    for i, raw in enumerate(screen_text.splitlines()):
        line_base = i * 100_000
        spans = {clean_visible_line(raw)}
        spans.update(m.group(1).strip() for m in QUOTED_RE.finditer(raw))
        for m in TOKEN_RE.finditer(raw):
            consider(m.group(0), line_base + m.start(), m.group(0) in spans)
        # Whole lines and quoted spans may hold paths with spaces in them.
        for span in spans:
            if span and TOKEN_RE.fullmatch(span) is None:
                consider(span, line_base + max(raw.find(span), 0), True)

    return sort_items(matches, sort)


# --------------------------------------------------------------------------- #
# Target parsing
# --------------------------------------------------------------------------- #

TARGET_RE = re.compile(r"^(.+?):([0-9]+)(:[0-9]+)?:?$")
TARGET_CTX_RE = re.compile(r"^(.+)-([0-9]+)-$")


def parse_selected_target(text: str) -> ParsedTarget:
    t = text.split("\n", 1)[0].rstrip("\r").strip()
    t = t.strip("`'\"").strip()
    t = t.rstrip(".,;:").strip()
    if not t:
        return ParsedTarget(path="")

    file_target = t
    line_target = ""

    m = TARGET_RE.match(t)
    if m:
        file_target = m.group(1)
        line_target = m.group(2)
    else:
        m = TARGET_CTX_RE.match(t)
        if m:
            file_target = m.group(1)
            line_target = m.group(2)

    return ParsedTarget(path=file_target, line=line_target)


# --------------------------------------------------------------------------- #
# Path resolution
# --------------------------------------------------------------------------- #

def resolve_existing_path(path_text: str, pane_path: Path, search_root: Path) -> Path | None:
    if path_text == "~":
        expanded = Path.home()
        if expanded.exists():
            return expanded
        return None

    if path_text.startswith("~/"):
        expanded = Path.home() / path_text[2:]
        if expanded.exists():
            return expanded
        return None

    if path_text.startswith("/"):
        p = Path(path_text)
        if p.exists():
            return p
        return None

    # Relative: try pane_path first, then search_root
    for base in (pane_path, search_root):
        p = base / path_text
        if p.exists():
            return p

    return None


# --------------------------------------------------------------------------- #
# Television
# --------------------------------------------------------------------------- #

def parse_tv_result(stdout: str, expect_keys: tuple[str, ...]) -> PickerResult:
    """Parse Television's stdout selection protocol.

    Enter prints only the selection. A key supplied through ``--expect`` prints
    the key first, followed by the selection.
    """
    lines = stdout.rstrip("\n").split("\n") if stdout else []
    if not lines:
        return PickerResult()
    if lines[0] in expect_keys:
        return PickerResult(key=lines[0], selection="\n".join(lines[1:]))
    return PickerResult(selection="\n".join(lines))


def _television_cable_dir() -> Path:
    return Path(__file__).resolve().parent / "cable"


def encode_candidate(candidate: str) -> str:
    """Return a shell-safe opaque id for a Television candidate."""
    return base64.urlsafe_b64encode(candidate.encode("utf-8")).decode("ascii").rstrip("=")


def decode_candidate(encoded: str) -> str:
    """Restore a candidate id emitted by the bundled Television channels."""
    if not encoded or not re.fullmatch(r"[A-Za-z0-9_-]+", encoded):
        raise ValueError("invalid Television candidate id")
    padding = "=" * (-len(encoded) % 4)
    try:
        return base64.urlsafe_b64decode(encoded + padding).decode("utf-8")
    except (binascii.Error, UnicodeDecodeError) as exc:
        raise ValueError("invalid Television candidate id") from exc


def _write_candidate_file(path: Path, candidates: list[str]) -> None:
    records = [f"{encode_candidate(candidate)}\t{candidate}" for candidate in candidates]
    content = "\n".join(records)
    if records:
        content += "\n"
    path.write_text(content, encoding="utf-8")


def _picker_error(message: str) -> None:
    print(f"termscope: {message}", file=sys.stderr)
    herdr = os.environ.get("HERDR_BIN_PATH")
    if herdr:
        subprocess.run(
            [herdr, "notification", "show", f"Termscope: {message}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


_HOMEBREW_TV_PATHS = ("/opt/homebrew/bin/tv", "/usr/local/bin/tv")
_TELEVISION_PATH_FILE = "television.path"


def _is_executable(path: str) -> bool:
    return bool(path) and os.path.isfile(path) and os.access(path, os.X_OK)


def _television_path_file() -> Path:
    config_home = os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
    return Path(config_home) / "termscope" / _TELEVISION_PATH_FILE


def _recorded_television_path() -> str | None:
    try:
        recorded = _television_path_file().read_text(encoding="utf-8").strip()
    except OSError:
        return None
    return recorded or None


def _television_candidates() -> list[str]:
    """Absolute Television paths that do not depend on an interactive shell PATH."""
    candidates: list[str] = []
    env_path = os.environ.get("TERMSCOPE_TV", "").strip()
    if env_path:
        candidates.append(env_path)
    recorded = _recorded_television_path()
    if recorded:
        candidates.append(recorded)
    which = shutil.which("tv")
    if which:
        candidates.append(which)
    prefix = os.environ.get("HOMEBREW_PREFIX", "").strip()
    if prefix:
        candidates.append(str(Path(prefix) / "bin" / "tv"))
    candidates.extend(_HOMEBREW_TV_PATHS)
    return candidates


def _television_path() -> str | None:
    """Find Television when Herdr's popup PATH omits Homebrew."""
    seen: set[str] = set()
    for candidate in _television_candidates():
        if candidate in seen:
            continue
        seen.add(candidate)
        if _is_executable(candidate):
            return candidate
    return None


def _television_is_supported(television: str) -> bool:
    try:
        result = subprocess.run(
            [television, "--version"],
            text=True,
            capture_output=True,
            check=False,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    if result.returncode != 0:
        return False
    match = re.search(r"\btelevision\s+(\d+)\.(\d+)\.(\d+)", result.stdout)
    return bool(match and tuple(map(int, match.groups())) >= (0, 15, 0))


def _run_tv(
    candidates: list[str],
    header: str,
    expect_keys: tuple[str, ...],
    sort: str = "appearance",
    cwd: Path | None = None,
    preview: bool = True,
) -> PickerResult | None:
    input_lines = [candidate for candidate in candidates if candidate.strip()]
    if not input_lines:
        return None

    television = _television_path()
    if not television:
        _picker_error("television (tv) not found")
        raise SystemExit(1)
    if not _television_is_supported(television):
        _picker_error("Television 0.15+ is required")
        raise SystemExit(1)

    cwd = cwd or Path.cwd()
    with tempfile.TemporaryDirectory(prefix="termscope-tv-") as temp_dir:
        temp_path = Path(temp_dir)
        appearance_path = temp_path / "appearance.txt"
        alpha_path = temp_path / "alpha.txt"
        _write_candidate_file(appearance_path, input_lines)
        _write_candidate_file(alpha_path, sorted(input_lines, key=str.lower))

        env = os.environ.copy()
        television_path = Path(television)
        if television_path.is_absolute():
            tv_dir = str(television_path.resolve().parent)
            path_parts = [part for part in env.get("PATH", "").split(os.pathsep) if part]
            if tv_dir not in path_parts:
                env["PATH"] = os.pathsep.join([tv_dir, *path_parts]) if path_parts else tv_dir
        env.update(
            {
                "TERMSCOPE_APPEARANCE_CANDIDATES": str(appearance_path),
                "TERMSCOPE_ALPHA_CANDIDATES": str(alpha_path),
                "TERMSCOPE_PANE_PATH": str(cwd),
                "TERMSCOPE_PYTHON": sys.executable,
                "TERMSCOPE_SCRIPT": str(Path(__file__).resolve()),
            }
        )

        command = [
            television,
            "--cable-dir",
            str(_television_cable_dir()),
            "--no-remote",
            "--no-help-panel",
            "--input-header",
            header,
        ]
        if expect_keys:
            command.extend(["--expect", ";".join(expect_keys)])
        if not preview:
            command.append("--no-preview")
        command.append(f"termscope-{sort}")

        try:
            result = subprocess.run(
                command,
                cwd=cwd,
                env=env,
                text=True,
                stdout=subprocess.PIPE,
                check=False,
            )
        except FileNotFoundError:
            _picker_error("television (tv) not found")
            raise SystemExit(1)

    if result.returncode != 0:
        _picker_error(f"Television failed with status {result.returncode}")
        raise SystemExit(result.returncode)

    if result.stdout == "":
        return PickerResult()
    picker_result = parse_tv_result(result.stdout, expect_keys)
    if not picker_result.selection:
        _picker_error("Television returned an invalid selection")
        raise SystemExit(1)
    try:
        picker_result.selection = decode_candidate(picker_result.selection)
    except ValueError:
        _picker_error("Television returned an invalid selection")
        raise SystemExit(1)
    if picker_result.selection not in input_lines:
        _picker_error("Television returned an unknown selection")
        raise SystemExit(1)
    return picker_result


def display_path(path: Path) -> str:
    try:
        relative = path.relative_to(Path.home())
    except ValueError:
        return str(path)
    return "~" if relative == Path(".") else f"~/{relative}"


def run_tv_visible(
    candidates: list[str], search_root: Path, sort: str = "appearance"
) -> PickerResult | None:
    return _run_tv(
        candidates,
        f"Files — {display_path(search_root)}",
        ("ctrl-o", "ctrl-y"),
        sort=sort,
        cwd=search_root,
    )


def run_tv_links(
    candidates: list[str], pane_path: Path, sort: str = "appearance"
) -> PickerResult | None:
    return _run_tv(
        candidates,
        "Visible links — Enter opens · Ctrl-Y copies · Ctrl-S changes order",
        ("ctrl-y",),
        sort=sort,
        cwd=pane_path,
        preview=False,
    )


def sort_file_list(files: list[str], sort: str = "appearance") -> list[str]:
    """Sort a plain file list alphabetically or leave it as-is."""
    if sort == "alpha":
        return sorted(files, key=lambda s: s.lower())
    return files


def run_tv_full_repo(
    search_root: Path, sort: str = "appearance", prepend: list[str] | None = None
) -> PickerResult | None:
    """Show all repo files when no visible file exists; visible URLs stay listed first."""
    candidates = (prepend or []) + list_repo_files(search_root)
    if not candidates:
        return None
    return _run_tv(
        candidates,
        f"All files — {display_path(search_root)}",
        ("ctrl-o", "ctrl-y"),
        sort=sort,
        cwd=search_root,
    )


